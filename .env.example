# Supabase authentication + persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, bypasses Row Level Security. Never prefix with NEXT_PUBLIC_
# and never expose to client code. Used only by narrow privileged
# server-side operations that cannot run through a user-scoped session.
SUPABASE_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Web Push / VAPID
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Vercel KV / storage
STORAGE_KV_REST_API_URL=
STORAGE_KV_REST_API_TOKEN=

# Cron protection
CRON_SECRET=